
# === Backend Auth ===
JWT_SECRET=change-this-secret-to-a-long-random-value
JWT_ISSUER=skinai
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=1209600
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin1234

# === Kakao Local API ===
KAKAO_REST_API_KEY=

# === MariaDB / RDS ===
SPRING_DATASOURCE_URL=jdbc:mariadb://mariadb:3306/skinai_auth
SPRING_DATASOURCE_USERNAME=skinai
SPRING_DATASOURCE_PASSWORD=skinai

# === MongoDB / Atlas ===
# Local compose default:
SPRING_DATA_MONGODB_URI=mongodb://mongo:27017/skinai
SPRING_MONGODB_URI=mongodb://mongo:27017/skinai
# Atlas example:
# SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/skinai?retryWrites=true&w=majority
# SPRING_MONGODB_URI=${SPRING_DATA_MONGODB_URI}

# === S3 Storage ===
AWS_REGION=ap-northeast-2
S3_BUCKET=
S3_PRESIGNED_URL_TTL=PT1H
